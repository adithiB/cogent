DATABASE_URL=postgres://cogent:cogent_dev_only@localhost:5432/cogent
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3001

# ADR-0004 amendment (2026-07-23): local Ollama, not a paid API — no key,
# no billing account, no per-request cost. Server-side only regardless.
COGENT_OLLAMA_BASE_URL=http://localhost:11434
COGENT_OLLAMA_MODEL=llama3.2
# Optional — overrides the 500-token default per-query question budget
# (ADR-0004 amendment §3a); the verification lever for manufacturing the
# budget-exceeded state on demand.
ASSISTANT_MAX_QUESTION_TOKENS=
